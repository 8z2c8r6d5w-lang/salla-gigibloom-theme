{
    "name": "@salla.sa/analytics",
    "version": "2.14.583",
    "description": "Salla unified analytics: Jitsu engine, event transformers and trackers for storefront (twilight) and checkout",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./storefront": {
            "import": "./dist/esm/storefront.js",
            "require": "./dist/cjs/storefront.js"
        },
        "./checkout": {
            "import": "./dist/esm/checkout.js",
            "require": "./dist/cjs/checkout.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "npx rollup --config --bundleConfigAsCjs --preserveSymlinks=true",
        "watch": "npx rollup --watch --config --bundleConfigAsCjs --preserveSymlinks=true",
        "test": "echo \"analytics is covered by the @salla.sa/twilight jest suite\" && exit 0"
    },
    "keywords": [
        "salla",
        "analytics",
        "jitsu",
        "tracking",
        "events"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/SallaApp/twilight.git"
    },
    "author": "Salla.sa",
    "license": "GPL-3.0",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "package.json"
    ],
    "homepage": "https://salla.dev",
    "dependencies": {
        "@jitsu/js": "^1.10.4"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.0",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-terser": "^0.4.4",
        "rollup": "^4.63.1",
        "rollup-plugin-analyzer": "^4.0.0",
        "rollup-plugin-cleaner": "^1.0.0",
        "rollup-plugin-exclude-dependencies-from-bundle": "^1.1.24",
        "rollup-plugin-version-injector": "^1.3.3"
    },
    "gitHead": "0de711fb8c992ef9af25cd6f1d41af3f94c2d2a8"
}
